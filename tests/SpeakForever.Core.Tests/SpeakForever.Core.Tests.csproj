<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>SpeakForever.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\app\Core\SpeakForever.Core.csproj" />
    <None Include="../fixtures/addon-bridge-geometry.json" Link="addon-bridge-geometry.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/addon-envelope.json" Link="addon-envelope.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
